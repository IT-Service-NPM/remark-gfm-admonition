{
	"name": "@it-service-npm/mdast-util-gfm-admonition",
	"type": "module",
	"version": "0.0.1",
	"description": "This extension extends MDAST functionality, enabling it to work with GitHub admonitions",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"mdast",
		"mdast-extension",
		"mdast-util",
		"markdown",
		"gfm",
		"admonitions",
		"callout",
		"callouts"
	],
	"author": {
		"name": "Sergei S. Betke",
		"email": "Sergey.S.Betke@yandex.ru",
		"url": "https://github.com/sergey-s-betke"
	},
	"homepage": "https://github.com/IT-Service-NPM/remark-gfm-admonition",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IT-Service-NPM/remark-gfm-admonition.git",
		"directory": "packages/mdast-util-gfm-admonition"
	},
	"bugs": {
		"url": "https://github.com/IT-Service-NPM/remark-gfm-admonition/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.0"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build --clean && tsc --build",
		"CI": "pnpm run build && pnpm run lint && pnpm run test && pnpm run build:readme:API && pnpm run build:readme",
		"check-exports": "attw --pack .",
		"lint": "tsc && eslint",
		"test": "node --import tsx --experimental-transform-types --experimental-test-module-mocks --experimental-test-coverage --test-reporter=spec --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=test/results/junit-report.xml --test-reporter-destination=coverage/lcov.info --test",
		"test:snapshots": "node --import tsx --experimental-transform-types --experimental-test-module-mocks --test-update-snapshots --test",
		"build:readme:API": "npx api-extractor run --local && npx api-documenter markdown -i temp -o docs",
		"build:readme:examples": "remark test/examples/*/readme.md --output",
		"build:readme:main": "remark .readme.md --output README.md",
		"build:readme": "pnpm run build:readme:examples && pnpm run build:readme:main",
		"build:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
	},
	"packageManager": "pnpm@10.30.3",
	"dependencies": {
		"@it-service-npm/micromark-extension-gfm-admonition": "*",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-to-markdown": "^2.1.2"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.3.3",
		"mdast-util-directive": "^3.1.0",
		"micromark-util-types": "^2.0.2",
		"typescript": "^5.9.3",
		"unified": "^11.0.5",
		"unist-util-remove-position": "^5.0.0",
		"vfile": "^6.0.3"
	}
}
