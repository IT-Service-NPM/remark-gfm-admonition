{
	"name": "@it-service-npm/micromark-extension-gfm-admonition",
	"type": "module",
	"version": "1.0.0",
	"description": "This plugin extends Remark's functionality, enabling it to read GitHub admonitions from Markdown and write them back to Markdown files",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"remark-plugin",
		"markdown",
		"gfm",
		"admonitions",
		"callout",
		"callouts"
	],
	"author": {
		"name": "Sergei S. Betke",
		"email": "Sergey.S.Betke@yandex.ru",
		"url": "https://github.com/sergey-s-betke"
	},
	"homepage": "https://github.com/IT-Service-NPM/remark-gfm-admonition",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IT-Service-NPM/remark-gfm-admonition.git",
		"directory": "packages/micromark-extension-gfm-admonition"
	},
	"bugs": {
		"url": "https://github.com/IT-Service-NPM/remark-gfm-admonition/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.0"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build --clean && tsc --build",
		"CI": "pnpm run build && pnpm run lint && pnpm run test && pnpm run build:readme:API && pnpm run build:readme",
		"check-exports": "attw --pack .",
		"lint": "tsc && eslint",
		"test": "node --import tsx --experimental-test-module-mocks --experimental-test-coverage --test-reporter=spec --test-reporter=junit --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=test/results/junit-report.xml --test-reporter-destination=coverage/lcov.info --test",
		"test:snapshots": "node --import tsx --experimental-test-module-mocks --test-update-snapshots --test",
		"build:readme:API": "api-extractor run --local && api-documenter markdown -i temp -o docs",
		"build:readme:examples": "glob-exec --parallel --foreach \"test/examples/*/readme.mdp\" \"remark {{file}} --output {{file.dir}}/readme.md\"",
		"build:readme:main": "remark .readme.md --output README.md",
		"build:readme": "pnpm run build:readme:examples && pnpm run build:readme:main",
		"build:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
	},
	"packageManager": "pnpm@10.30.3",
	"dependencies": {
		"micromark-util-character": "^2.1.1",
		"micromark-util-symbol": "^2.0.1"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.7.0",
		"mdast-util-directive": "^3.1.0",
		"micromark": "^4.0.2",
		"micromark-util-types": "^2.0.2",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"vfile": "^6.0.3"
	}
}
